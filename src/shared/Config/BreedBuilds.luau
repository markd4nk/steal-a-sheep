--!strict

-- Generated by art/sheep/build_breeds.py from the picked mock-ups: don't edit by hand. Each breed with its own
-- build (GameConfig's Breed.Build): its wool, a mesh per slot in its first wool colour with the slot's other
-- colours and materials hanging under it (Puff), its extras welded to the rig pieces they sit on, the rig pieces
-- it hides, how far its body floats over its feet (Lift, studs at Scale 1), its face, and its wool's underside
-- for a carrier's palms (SheepRigLayout.Underside). Textures are the patterned materials' pictures (a mesh's
-- Texture names one; art/sheep/textures/, uploaded, ids in art/sheep/textures.json).

export type Mesh = {
	Mesh: string,
	Name: string,
	Piece: string,
	Puff: string?,
	Tint: string?,
	Color: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
	Texture: string?,
	ShowAt: number?, -- the share of its wool from which it shows
	HideAt: number?, -- and from which it hides again
	SpinAxis: Vector3?, -- it turns about this axis through SpinPivot (rig space), SpinSpeed degrees a second
	SpinSpeed: number?,
	SpinPivot: Vector3?,
	SwingAngle: number?, -- or rocks this many degrees either way, SwingPeriod seconds there and back
	SwingPeriod: number?,
	SwingPhase: number?, -- the share of a period it's ahead
	SwingTicks: number?, -- in this many steps a period instead of smoothly
	Hop: number?, -- or hops this high (studs at Scale 1) once every SwingPeriod seconds
	Settle: Vector3?, -- moved this far (rig space) while the wool under it is gone
	SettleFrom: number?, -- rising back from this share of the wool
	SettleTo: number?, -- to this one
	ShornColor: Color3?, -- shorn, it turns this colour instead of going
}

export type RigPlace = { Center: Vector3?, Size: Vector3?, Pivot: Vector3? }

export type Build = {
	Wool: { Mesh },
	Extras: { Mesh },
	Hides: { string },
	Lift: number,
	Face: string?,
	FaceOverlay: string?,
	EarPlace: string,
	FaceByWool: { { At: number, Face: string } }?, -- its face from each share of its wool up
	Underside: { PuffX: number, PuffY: number, HalfWidth: number, Hang: number },
	-- Rig pieces the breed moves, in model space at Scale 1: a box's centre and size, its joint's pivot.
	Rig: { [string]: RigPlace }?,
	Length: number?, -- a long breed's back, from its middle toward its tail: it shears all along (studs at Scale 1)
	-- Carried lying down: turned Tilt degrees about the rig's X axis through Pivot, then raised Drop so its lowest
	-- point is its feet's height (studs at Scale 1); its Underside is measured lying so.
	Carry: { Tilt: number, Pivot: Vector3, Drop: number }?,
	IdleActions: { [string]: number }?, -- its own weights for the pen's idle actions (a two-legged body's)
}

