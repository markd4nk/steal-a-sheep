--!strict

-- The mountain: thirty tiers up one ramp, each a god's pasture with its own sheep family. The commissioned map (vvs_map)
-- is the first eleven and a half: one corridor climbing east (+X) from the plots in seven themed stages that get
-- steeper (2, 7, 12, 17, 22, 29 and 31 degrees), long stages holding two or three tiers, gods ordered to fit each
-- stage's theme (meadow, bamboo, snow, lava, rose garden, marble temple, golden cloud path). Above its old summit,
-- High Olympus (tools/UpperMountain.luau, built into the place) carries on with one stretch a god, 32 degrees rising
-- to 52, up to Zeus's throne. Every tier keeps the design's numbers in order (reach threshold, income), so swapping
-- two gods is a matter of swapping their rows' names and looks.

export type Tier = {
	Tier: number,
	God: string,
	Area: string,
	Family: string, -- GameConfig.Breeds key
	FamilyName: string,
	Reach: number, -- Climb Power to climb into this tier
	XStart: number, -- the tier's gate on the ramp (studs along +X)
	XEnd: number,
	SlideSpeed: number, -- an empty-handed slide's target speed on this stretch
	-- The god's primitive look.
	Robe: Color3,
	Skin: Color3,
	Accent: Color3,
	Sign: string, -- their signature accessory (GodService builds it)
}

